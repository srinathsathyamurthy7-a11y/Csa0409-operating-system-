  #include <stdio.h>
  #include <stdlib.h>
  int main() {
    int n, head, diskSize;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    int request[n];
    printf("Enter disk requests:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &request[i]);
    }
    printf("Enter initial head position: ");
    scanf("%d", &head);
    printf("Enter disk size: ");
    scanf("%d", &diskSize);
    /* FCFS */
    int current = head;
    int fcfs = 0;
    printf("\nFCFS Sequence: %d ", current);
    for (int i = 0; i < n; i++) {
        fcfs += abs(request[i] - current);
        current = request[i];
        printf("%d ", current);
    }
    printf("\nTotal FCFS Seek Time = %d\n", fcfs);
    /* SSTF */
    int visited[n];
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
    }
    current = head;
    int sstf = 0;
    printf("\nSSTF Sequence: %d ", current);
    for (int i = 0; i < n; i++) {
        int min = 999999;
        int index = -1;
        for (int j = 0; j < n; j++) {
            if (visited[j] == 0) {
                int distance = abs(request[j] - current);
                if (distance < min) {
                    min = distance;
                    index = j;
                }
            }
        }
        visited[index] = 1;
        sstf += min;
        current = request[index];
        printf("%d ", current);
    }
    printf("\nTotal SSTF Seek Time = %d\n", sstf);
    /* Sorting for SCAN */
    int a[n];
    for (int i = 0; i < n; i++) {
        a[i] = request[i];
    }
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
    /* SCAN - Moving Right */
    current = head;
    int scan = 0;
    int index;
    printf("\nSCAN Sequence: %d ", current);
    for (index = 0; index < n; index++) {
        if (a[index] >= head) {
            break;
        }
    }
    for (int i = index; i < n; i++) {
        scan += abs(a[i] - current);
        current = a[i];
        printf("%d ", current);
    }
    scan += abs((diskSize - 1) - current);
    current = diskSize - 1;
    printf("%d ", current);
    for (int i = index - 1; i >= 0; i--) {
        scan += abs(a[i] - current);
        current = a[i];
        printf("%d ", current);
    }
    printf("\nTotal SCAN Seek Time = %d\n", scan);
    /* Best Algorithm */
    int min = fcfs;
    char best[10] = "FCFS";
    if (sstf < min) {
        min = sstf;
        sprintf(best, "SSTF");
    }
    if (scan < min) {
        min = scan;
        sprintf(best, "SCAN");
    }
    printf("\nBest Performing Algorithm = %s", best);
    printf("\nMinimum Seek Time = %d\n", min);
    return 0;
}


