#include <stdio.h>
int main() {
    int n, size, choice;
    printf("Enter total disk blocks: ");
    scanf("%d", &n)
    int disk[n];
    printf("Enter disk status (0-Free, 1-Allocated):\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &disk[i]);
    }
    printf("Enter file size: ");
    scanf("%d", &size);
    printf("\n1. Contiguous Allocation\n");
    printf("2. Linked Allocation\n");
    printf("3. Indexed Allocation\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    if (choice == 1) {
        int found = 0;
        for (int i = 0; i <= n - size; i++) {
            int free = 1;
            for (int j = i; j < i + size; j++) {
                if (disk[j] == 1) {
                    free = 0;
                    break;
                }
            }
            if (free == 1) {
                printf("Allocated blocks: ");
                for (int j = i; j < i + size; j++) {
                    disk[j] = 1;
                    printf("%d ", j);
                }
                found = 1;
                break;
            }
        }
        if (found == 0) {
            printf("Allocation failed: No contiguous space available.");
        }
    }
    else if (choice == 2) {
        int count = 0;
        printf("Allocated blocks: ");
        for (int i = 0; i < n && count < size; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        if (count < size) {
            printf("\nAllocation failed: Insufficient free blocks.");
        }
    }
    else if (choice == 3) {
        int indexBlock = -1;
        int count = 0;
        for (int i = 0; i < n; i++) {
            if (disk[i] == 0) {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }
        if (indexBlock == -1) {
            printf("Allocation failed: No free index block.");
        }
        else {
            printf("Index Block: %d\n", indexBlock);
            printf("Allocated File Blocks: ");
            for (int i = 0; i < n && count < size; i++) {
                if (disk[i] == 0) {
                    disk[i] = 1;
                    printf("%d ", i);
                    count++;
                }
            }
            if (count < size) {
                printf("\nAllocation failed: Insufficient free blocks.");
            }
        }
    }
    else {
        printf("Invalid choice.");
    }
    return 0;
}


