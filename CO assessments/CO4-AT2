                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
    /* C-SCAN */
    int current = head;
    int cscan = 0;
    int index;
    printf("\nC-SCAN Sequence: %d ", current);
    for (index = 0; index < n; index++) {
        if (a[index] >= head) {
