    printf("Enter allocation method: ");
    scanf("%d", &allocationChoice);
    int allocated[fileSize];
    int success = 0;
    /* Contiguous Allocation */
    if (allocationChoice == 1) {
        for (int i = 0; i <= n - fileSize; i++) {
            int free = 1;
            for (int j = i; j < i + fileSize; j++) {
                if (disk[j] == 1) {
                    free = 0;
                    break;
                }
            }
           if (free == 1) {
                for (int j = 0; j < fileSize; j++) {
                    allocated[j] = i + j;
                    disk[i + j] = 1;
                }
                success = 1;
                break;
            }
        }
        if (success == 0) {
            printf("Contiguous allocation failed.");
            return 0;
        }
    }
    /* Indexed Allocation */
    else if (allocationChoice == 2) {
        int count = 0;
        for (int i = 0; i < n && count < fileSize; i++) {
            if (disk[i] == 0) {
                allocated[count] = i;
                disk[i] = 1;
                count++;
            }
        }
        if (count == fileSize) {
            success = 1;
        }
        else {
            printf("Indexed allocation failed.");
            return 0;
        }
