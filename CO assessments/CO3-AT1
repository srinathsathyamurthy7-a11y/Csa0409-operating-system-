#include <stdio.h>
int main()
{
    float hitRatio;
    int memoryTime, tlbTime;
    float withoutTLB, withTLB;
    printf("Enter Memory Access Time: ");
    scanf("%d",&memoryTime);
    printf("Enter TLB Access Time: ");
    scanf("%d",&tlbTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f",&hitRatio);
    withoutTLB = 2 * memoryTime;
    withTLB = hitRatio * (tlbTime + memoryTime) +
             (1 - hitRatio) * (tlbTime + 2 * memoryTime);
    printf("Without TLB = %.2f ns\n",withoutTLB);
    printf("With TLB = %.2f ns\n",withTLB)
    return 0;
}

