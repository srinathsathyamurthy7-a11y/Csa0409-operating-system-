#include <stdio.h>
int main()
{
    int pageTable[10];
    int n,pageSize,logical,page,offset,frame,physical;
    printf("Enter number of pages: ");
    scanf("%d",&n);
    printf("Enter page size: ");
    scanf("%d",&pageSize);
    for(int i=0;i<n;i++)
    {
        printf("Frame for Page %d: ",i);
        scanf("%d",&pageTable[i]);
    }
    printf("Enter Logical Address: ");
    scanf("%d",&logical);
    page=logical/pageSize;
    offset=logical%pageSize;
    if(page<n)
    {
        frame=pageTable[page];
        physical=(frame*pageSize)+offset;
        printf("Page Number = %d\n",page);
        printf("Offset = %d\n",offset);
        printf("Frame Number = %d\n",frame);
        printf("Physical Address = %d\n",physical);
    }
    else
    {
        printf("Invalid Address\n");
    }
    return 0;
}

